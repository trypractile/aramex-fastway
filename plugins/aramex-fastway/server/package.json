{
  "name": "aramex-fastway-mcp",
  "version": "0.3.0",
  "description": "MCP server for the Aramex (Fastway) AU/NZ shipping API",
  "main": "dist/index.mjs",
  "scripts": {
    "build": "esbuild src/index.js --bundle --platform=node --target=node18 --format=esm --outfile=dist/index.mjs --banner:js=\"import{createRequire}from'module';const require=createRequire(import.meta.url);\"",
    "start": "node dist/index.mjs",
    "test": "node --test test/*.test.js"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18"
  }
}
